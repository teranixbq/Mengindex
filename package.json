{
  "name": "mengindex",
  "private": true,
  "version": "1.0.0",
  "description": "Manifest V3 Chrome Extension to inspect, filter, and run SQL queries on the active tab's local IndexedDB.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "vite preview --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:extension": "vite build && tsx scripts/package-extension.ts",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist release .extension-dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
